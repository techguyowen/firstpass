{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FirstPass",
  "version": "1.0.1",
  "identifier": "com.firstpass.app",
  "build": {
    "frontendDist": "../out/renderer",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "FirstPass",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "backgroundColor": "#090d14",
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*; img-src 'self' asset: http://127.0.0.1:* http://localhost:* data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Photography",
    "shortDescription": "Your shoot's first pass, done in minutes.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
